# ========== TELEGRAM ==========
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here

# ========== AI & LLM ==========
# Все модели через OpenRouter (один ключ на все)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ========== DATABASE ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ========== CACHE ==========
UPSTASH_REDIS_URL=redis://default:your_upstash_url

# ========== SEARCH ==========
BRAVE_API_KEY=your_brave_search_key_here

# ========== MONITORING ==========
LANGCHAIN_API_KEY=your_langfuse_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=autoparts-agents

# ========== URLS ==========
API_URL=http://localhost:8000
WEBHOOK_URL=http://localhost:8000/webhook
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== ENVIRONMENT ==========
ENV=development
DEBUG=true
